{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch TSP Dashboard Server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run CLI Benchmark Suite",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/cli/runBenchmark.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run TSP Unit Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/@test",
      "runtimeArgs": ["--test", "src/tests/tsp.test.js"]
    }
  ]
}
